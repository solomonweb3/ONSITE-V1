# Copy this file to .env.local and fill in your Supabase project values.
# Both are the public (publishable/anon) values — safe to ship in the app,
# protected by Row Level Security on the database side.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
